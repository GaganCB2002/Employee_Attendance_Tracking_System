# AttendX environment configuration (copy to .env and edit)
PORT=3000
# Change this to a long random string in production. Used to derive the
# AES-256-GCM key that encrypts photos/videos at rest, and password hashing.
APP_SECRET=change-me-to-a-long-random-secret
# Where the SQLite DB and encrypted media files are stored
DATA_DIR=./data
# Optional: enable HTTPS (TLS in transit) by pointing at a cert/key pair.
# TLS_CERT=./cert.pem
# TLS_KEY=./key.pem
