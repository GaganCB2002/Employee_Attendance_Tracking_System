# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendx?schema=public

# Security & Authentication
JWT_SECRET=attendx_super_secret_jwt_key_2026_telemetry_ops
JWT_EXPIRES_IN=8h
SESSION_TIMEOUT_MINUTES=15
MAX_FAILED_ATTEMPTS=3

# Geofence & Late Arrival Policy
DEFAULT_GEOFENCE_RADIUS_METERS=50
LATE_GRACE_PERIOD_MINUTES=15

# Storage Configuration (Local or S3-compatible)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
